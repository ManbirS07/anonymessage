// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Message {
  id        String   @id @default(uuid())
  userId    String    //message belongs to a user, so we need to store the userId as a foreign key
  user     User     @relation(fields: [userId], references: [id]) // Define the relation to the User model
  content   String
  createdAt DateTime @default(now())
}

model User{
  id       String   @id @default(uuid())
  username String   @unique 
  email    String   @unique
  password String   
  verifyCode String
  verifyCodeExpiry DateTime
  isAcceptingMessages Boolean @default(true)
  messages Message[]  
}